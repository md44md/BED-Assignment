# Copy this file to ".env" and fill in the values for your local setup.
# Do NOT commit your real .env (it is git-ignored).

# Port the Express server listens on
PORT=3000

# SQL Server connection
# DB_USER / DB_PASSWORD must match the login created in
# database/hawker_centre_schema.sql (CREATE LOGIN ...)
DB_USER=bed_user
DB_PASSWORD=YourPassword123
DB_SERVER=localhost
DB_DATABASE=HawkerCentreDatabase
DB_PORT=1433

# JWT settings
# Generate your own secret, e.g. in Node:
#   require("crypto").randomBytes(32).toString("hex")
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Cloudinary API connection
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
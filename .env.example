# Copy this file to ".env" and fill in the values for your local setup.
# Do NOT commit your real .env (it is git-ignored).

# Port the Express server listens on
PORT=3000

# SQL Server connection
# DB_USER / DB_PASSWORD must match the login created in
# database/hawker_centre_schema.sql (CREATE LOGIN ...)
DB_USER=bed_user
DB_PASSWORD=YourPassword123
DB_SERVER=localhost
DB_DATABASE=HawkerCentreDatabase
DB_PORT=1433

# JWT settings
# Generate your own secret, e.g. in Node:
#   require("crypto").randomBytes(32).toString("hex")
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Cloudinary API connection
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Brevo transactional email API (third-party notification service)
# Used to email the next customer when a stall owner advances the queue.
# 1. Create a free account at https://www.brevo.com
# 2. Create an API key: Account > SMTP & API > API Keys
# 3. Verify a sender address: Senders & IP > Senders
BREVO_API_KEY=replace_me_with_your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Hawker Centre Management System

# PDFShift HTML-to-PDF API (third-party document generation service)
# Used to let a customer download their itemized receipt as a PDF.
# 1. Create a free account at https://pdfshift.io
# 2. Copy your API key from the dashboard
# PDFSHIFT_SANDBOX=true (default) produces free watermarked test PDFs; set to
# "false" once on a paid/production key for clean output.
PDFSHIFT_API_KEY=replace_me_with_your_pdfshift_api_key
PDFSHIFT_SANDBOX=true
# OneMap API (third-party mapping service, Singapore Land Authority)
# Used to find hawker centres near a customer and give directions to them.
# NOTE: geocoding (the "nearby" feature) is a public endpoint and needs NO
# credentials. These are only required for directions/routing.
# 1. Register a free account at https://www.onemap.gov.sg
# 2. Use the SAME email/password you registered with (no separate API key).
#    The app exchanges them for a 3-day token automatically, so you never
#    paste a token here.
ONEMAP_EMAIL=your_onemap_account_email
ONEMAP_PASSWORD=your_onemap_account_password
